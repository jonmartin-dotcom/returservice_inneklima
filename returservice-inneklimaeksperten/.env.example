# Kopier denne filen til .env.local for lokal utvikling.
# I Vercel: legg disse inn under Project Settings -> Environment Variables.

# --- Ongoing WMS ---
ONGOING_WAREHOUSE=logista
ONGOING_USERNAME=API-bruker
ONGOING_PASSWORD=
ONGOING_GOODS_OWNER_ID=124
ONGOING_WAREHOUSE_ID=7
ONGOING_USE_DEMO_SERVER=false

# --- Webshipper ---
WEBSHIPPER_ACCOUNT_NAME=spring-nova-immitec
WEBSHIPPER_ACCESS_TOKEN=
WEBSHIPPER_CARRIER_ID=1
WEBSHIPPER_SERVICE_CODE=9300

WEBSHIPPER_DEFAULT_ITEM_WEIGHT_G=500
WEBSHIPPER_DEFAULT_ITEM_LENGTH_CM=30
WEBSHIPPER_DEFAULT_ITEM_WIDTH_CM=20
WEBSHIPPER_DEFAULT_ITEM_HEIGHT_CM=10

# --- Lagerets (varemottakers) adresse ---
WAREHOUSE_RETURN_NAME=Spring Logistikk c/o Inneklimaeksperten
WAREHOUSE_RETURN_STREET=Borgeskogen 65
WAREHOUSE_RETURN_POSTAL_CODE=3160
WAREHOUSE_RETURN_CITY=Stokke
WAREHOUSE_RETURN_COUNTRY_CODE=NO
